{
	"name": "Wesmere",
	"description": "New Wesnoth.org site design",
	"author": [
		"Iris Morelle (Irydacea)"
	],
	"version": "1.3.0",
	"url": "https://github.com/wesnoth/wesmere",
	"license-name": "GNU GPL v2+",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"ValidSkinNames": {
		"wesmere": {
			"class": "Wesmere\\SkinWesmere",
			"args": [
				{
					"name": "wesmere",
					"bodyOnly": true,
					"responsive": true,
					"template": "Wesmere\\WesmereTemplate",
					"scripts": [
						"skins.wesmere.js"
					]
				}
			]
		}
	},
	"Hooks": {
		"BeforePageDisplay": [
			"Wesmere\\WesmereHooks::onBeforePageDisplay"
		]
	},
	"ResourceModules": {
		"skins.wesmere.js": {
			"scripts": [
				"js/wiki.js"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "../../wesmere",
		"remoteSkinPath": "../../wesmere"
	},
	"AutoloadNamespaces": {
		"Wesmere\\": "includes/"
	},
	"manifest_version": 1
}
